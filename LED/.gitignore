############################################
# ========== CMake 生成文件 ==========
############################################
# CMake 构建目录（强烈建议 out-of-source）
build/
build-*/
cmake-build-*/
out/

# CMake 生成的缓存和中间文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

############################################
# ========== 编译产物 ==========
############################################
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.elf
*.axf
*.map
*.lst
*.hex
*.bin

############################################
# ========== IDE / 编辑器 ==========
############################################
# CLion
.idea/
cmake-build-debug/
cmake-build-release/

# VS Code
.vscode/

# Visual Studio
.vs/
*.vcxproj*
*.sln

############################################
# ========== 调试 / 日志 ==========
############################################
*.log
*.tmp
*.bak
*.swp

############################################
# ========== 系统文件 ==========
############################################
.DS_Store
Thumbs.db

############################################
# ========== STM32 / 嵌入式（可选） ==========
############################################
# CubeMX
*.ioc

# OpenOCD
openocd.cfg

